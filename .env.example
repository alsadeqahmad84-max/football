# Add secrets only to the ignored .env.local file. Never use VITE_ prefixes for secrets.
NVIDIA_API_KEY=
NVIDIA_NEMOTRON_API_KEY=

# AgentMail daily system reports (set AGENTMAIL_INBOX_ID to your sender inbox ID or email).
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_REPORT_TO=
AGENTMAIL_REPORT_TIME=09:00
AGENTMAIL_REPORT_TIMEZONE=Asia/Amman
